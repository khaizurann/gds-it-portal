{
  // Must match the app name on Cloudflare
  "name": "it-portal",
  // The backend code (AI endpoint)
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    // The built React website
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes to the backend code first (it checks the login)
    "run_worker_first": true
  },
  // Turns on Workers AI (free daily allowance)
  "ai": { "binding": "AI" }
}
